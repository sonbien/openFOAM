FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.06;

boundaryField
{
    inlet
    {
        type            fixedValue;     //Can also let openfoam calculate k0 by using type turbulentIntensityKineticEnergyInlet
        value           uniform 0.06;
    }
    
    outlet
    {
        type            zeroGradient;
    }
      
    body
    {
        type            kqRWallFunction;
        value           uniform 0;
    }

    bottom
    {
        type            kqRWallFunction;
        value           uniform 0;
    }

    top
    {
        type            fixedValue;
        value           uniform 0.06;
    }
    
    sides
    {
        type            fixedValue;
        value           uniform 0.06;
    }
}


