FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
//code change (step2, step3)
    p
    {
        solver          GAMG;
        tolerance       1e-10;
        relTol          0.1;
        smoother        GaussSeidel;
    }


    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0.1;
    }
}
//code change (step2, step3) end


//code change (step 3)
SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent yes;
	

    residualControl
    {
        p               	1e-10;
        U               	1e-10;
        "(k|omega)"	 	1e-10;
    }
}
//code change (step 3) end


//code change (step4)
relaxationFactors
{
    fields
    {
        p               0.3;
    }
    equations
    {
        U               0.7;
        k               0.7;
        omega           0.7;
    }
}
//code change (step4) end

