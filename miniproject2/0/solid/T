FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/solid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293;

boundaryField
{
    bodyBottom
    {
        type            fixedValue;
        value           uniform 293;
    }

    "solid_to_.*"
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed; 
        value           uniform 293;
        Tnbr            T;
        kappaMethod     solidThermo;        //get conductivity from solid thermodynamics model
    }
}


