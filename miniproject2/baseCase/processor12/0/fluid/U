FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volVectorField;
    location    "0/fluid";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1 0 0);

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<vector> 0();
    }
    outlet
    {
        type            pressureInletOutletVelocity;
        value           nonuniform List<vector> 0();
    }
    walls
    {
        type            noSlip;
    }
    fluid_to_solid
    {
        type            noSlip;
    }
    procBoundary12to3
    {
        type            processor;
        value           uniform (1 0 0);
    }
    procBoundary12to5
    {
        type            processor;
        value           uniform (1 0 0);
    }
    procBoundary12to8
    {
        type            processor;
        value           uniform (1 0 0);
    }
    procBoundary12to9
    {
        type            processor;
        value           uniform (1 0 0);
    }
    procBoundary12to11
    {
        type            processor;
        value           uniform (1 0 0);
    }
    procBoundary12to13
    {
        type            processor;
        value           uniform (1 0 0);
    }
    procBoundary12to14
    {
        type            processor;
        value           uniform (1 0 0);
    }
    procBoundary12to15
    {
        type            processor;
        value           uniform (1 0 0);
    }
}


