FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/fluid";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 100000;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
        gradient        nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    outlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    walls
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 100000;
    }
    fluid_to_solid
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 100000;
    }
    procBoundary12to3
    {
        type            processor;
        value           uniform 100000;
    }
    procBoundary12to5
    {
        type            processor;
        value           uniform 100000;
    }
    procBoundary12to8
    {
        type            processor;
        value           uniform 100000;
    }
    procBoundary12to9
    {
        type            processor;
        value           uniform 100000;
    }
    procBoundary12to11
    {
        type            processor;
        value           uniform 100000;
    }
    procBoundary12to13
    {
        type            processor;
        value           uniform 100000;
    }
    procBoundary12to14
    {
        type            processor;
        value           uniform 100000;
    }
    procBoundary12to15
    {
        type            processor;
        value           uniform 100000;
    }
}


