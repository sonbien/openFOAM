FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/solid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 293;

boundaryField
{
    bodyBottom
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    solid_to_fluid
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           uniform 293;
    }
    procBoundary5to0
    {
        type            processor;
        value           uniform 293;
    }
    procBoundary5to1
    {
        type            processor;
        value           uniform 293;
    }
    procBoundary5to4
    {
        type            processor;
        value           uniform 293;
    }
    procBoundary5to7
    {
        type            processor;
        value           uniform 293;
    }
}


