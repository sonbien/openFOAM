FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/solid";
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    bodyBottom
    {
        type            zeroGradient;
    }
    solid_to_fluid
    {
        type            calculated;
        value           uniform 0;
    }
    procBoundary10to4
    {
        type            processor;
        value           uniform 1;
    }
    procBoundary10to8
    {
        type            processor;
        value           uniform 1;
    }
    procBoundary10to9
    {
        type            processor;
        value           uniform 1;
    }
    procBoundary10to11
    {
        type            processor;
        value           uniform 1;
    }
    procBoundary10to14
    {
        type            processor;
        value           uniform 1;
    }
    procBoundary10to15
    {
        type            processor;
        value           uniform 1;
    }
}


