4
(
    inlet
    {
        type            patch;
        nFaces          3600;
        startFace       1595200;
    }
    outlet
    {
        type            patch;
        nFaces          3600;
        startFace       1598800;
    }
    walls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          35900;
        startFace       1602400;
